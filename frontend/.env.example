# =============================================================================
# TechVal AI — Next.js Full-Stack Environment Configuration (Local & Vercel)
# =============================================================================

# 1. PostgreSQL Database Connection (Neon / Supabase / Vercel Postgres / Local PG)
# Paste your PostgreSQL URI below. Tables are auto-created on first request!
# Example (Neon / Supabase / Vercel):
# DATABASE_URL=postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 2. Meta AI (dev.meta.ai — Meta Model API)
META_AI_API_KEY=LLM_YOUR_META_AI_KEY
META_AI_BASE_URL=https://api.meta.ai/v1
META_AI_DEFAULT_MODEL=muse-spark-1.3

# 3. AES-256-GCM Encrypted Document Vault Secret
VAULT_ENCRYPTION_KEY=techval-production-vault-secret-key-2026
