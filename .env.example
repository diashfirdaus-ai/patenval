# TechVal AI — Local Environment Configuration
# Copy this file to .env and adjust values as needed.

APP_NAME="TechVal AI"
APP_VERSION="1.0.0"
APP_ENV="development"

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql+psycopg://postgres@localhost:5432/techval"
TEST_DATABASE_URL="postgresql+psycopg://postgres@localhost:5432/techval_test"

# Security & Encryption
# 32-byte URL-safe base64 key for Fernet encryption at rest (auto-generated if omitted in dev, required in prod)
STORAGE_ENCRYPTION_KEY="dGVjaHZhbC1haS1sb2NhbC1lbmNyeXB0aW9uLWtleS0zMmJ5dGVzIQ=="
SESSION_SECRET_KEY="techval-local-session-secret-change-in-production-2026"
SESSION_TTL_HOURS=24
MAX_UPLOAD_SIZE_MB=25

# Runtime directories (kept outside web root and source tree)
RUNTIME_DIR=".runtime"
ENCRYPTED_VAULT_DIR=".runtime/vault"
REPORT_STORAGE_DIR=".runtime/reports"
CHECKPOINT_DIR=".runtime/checkpoints"

# AI Providers (Explicit consent required before any external transmission)
# Supported providers: gemini | openai_compatible | fixture
DEFAULT_AI_PROVIDER="fixture"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_COMPATIBLE_BASE_URL="https://api.openai.com/v1"
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL="gpt-4o-mini"

# External Patent Data (EPO Open Patent Services - optional)
EPO_OPS_CONSUMER_KEY=""
EPO_OPS_CONSUMER_SECRET=""

# Server Ports
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
